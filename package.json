{
  "name": "szlaki-pienin",
  "version": "1.0.0",
  "private": true,
  "description": "Portal turystyczny o Pieninach — szlakipienin.pl",
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx narzedzia/zbuduj-geojson.ts && tsx narzedzia/przygotuj-odznaki.ts",
    "build": "next build",
    "lint": "eslint",
    "dane": "./narzedzia/synchronizuj-dane.sh",
    "zdjecia:trasy": "node narzedzia/przygotuj-zdjecia-tras.mjs",
    "daty": "tsx narzedzia/zbuduj-daty-stron.ts",
    "haslo": "tsx narzedzia/haslo-panelu.ts",
    "sieci": "tsx narzedzia/pobierz-sieci-centrow.ts",
    "skany:podglad": "tsx --env-file-if-exists=.env narzedzia/podglad-skanow.ts",
    "skany:przeklasyfikuj": "tsx --env-file-if-exists=.env narzedzia/przeklasyfikuj-skany.ts",
    "baza:migracja": "prisma migrate dev",
    "baza:wgraj": "prisma db seed",
    "baza:podglad": "prisma studio",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:obserwuj": "vitest",
    "karty": "tsx narzedzia/zbuduj-karty-druku.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@neondatabase/serverless": "1.1.0",
    "@prisma/adapter-neon": "7.9.1",
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "^5.62.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "jszip": "3.10.1",
    "lucide-react": "^0.469.0",
    "maplibre-gl": "^5.0.0",
    "next": "16.3.0",
    "opentype.js": "^2.0.0",
    "prisma": "6.19.3",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.16.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.4.0",
    "ws": "8.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/opentype.js": "^1.3.10",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "puppeteer": "^25.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
