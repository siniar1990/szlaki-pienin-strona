# Zmienne środowiskowe systemu tabliczek QR.
#
# Skopiuj do `.env` na czas pracy lokalnej, a na Vercelu wpisz je w ustawieniach
# projektu. Plik `.env` jest w .gitignore i nie może trafić do repozytorium.

# ── Baza danych ───────────────────────────────────────────────────────────
# DWA adresy, nie jeden — to nie pomyłka.
#
# DATABASE_URL wskazuje host z „-pooler" i służy do zwykłej pracy. Na
# środowisku bezserwerowym każde wywołanie funkcji chce własnego połączenia,
# a baza przyjmie ich ograniczoną liczbę; pula pilnuje, żeby nie zabrakło.
#
# DIRECT_URL wskazuje host bez „-pooler" i służy wyłącznie migracjom.
# PgBouncer w trybie transakcyjnym nie obsługuje instrukcji przygotowanych,
# których migracje używają — przez pulę po prostu się wywracają.
DATABASE_URL="postgresql://uzytkownik:haslo@host-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://uzytkownik:haslo@host.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ── Panel administracyjny ─────────────────────────────────────────────────
# Skrót hasła w formacie `sól:skrót`. Wygeneruj poleceniem:
#     npm run haslo -- "twoje-nowe-haslo"
# Samego hasła nigdzie nie zapisujemy — tylko ten skrót.
HASLO_PANELU="wklej-tu-wynik-polecenia"

# Sekret podpisujący ciasteczko sesji. Dowolny długi losowy ciąg:
#     openssl rand -hex 32
# Zmiana tej wartości unieważnia wszystkie sesje, co bywa przydatne.
SEKRET_SESJI="wklej-tu-losowy-ciag"

# ── Zadania cykliczne ─────────────────────────────────────────────────────
# Sekret, którym harmonogramy przedstawiają się trasom /api/cron/*.
# Bez niego każdy mógłby wywoływać zadania w pętli.
#     openssl rand -hex 32
SEKRET_ZADAN="wklej-tu-losowy-ciag"

# TA SAMA WARTOŚĆ pod drugą nazwą — i to nie jest pomyłka.
#
# Wbudowany harmonogram Vercela dokłada nagłówek `Authorization` sam, ale
# bierze go wyłącznie ze zmiennej o nazwie dokładnie `CRON_SECRET`. Nazwy nie
# da się zmienić, jest zaszyta po stronie dostawcy. Gdy tej zmiennej brakuje,
# Vercel nie wysyła nagłówka w ogóle, trasa odpowiada kodem 401, a zadanie
# „chodzi" co noc i za każdym razem nic nie robi — po cichu, bez błędu.
#
# Harmonogram GitHuba (obchód źródeł i redakcja) używa SEKRET_ZADAN.
# Harmonogram Vercela (konserwacja statystyk tabliczek) używa CRON_SECRET.
CRON_SECRET="ta-sama-wartosc-co-wyzej"

# ── Filtr botów w statystykach tabliczek ──────────────────────────────────
# Sekret podpisujący jednorazowe tokeny potwierdzające skan. Skan liczy się
# dopiero wtedy, gdy przeglądarka odeśle taki token — crawlery Facebooka
# i wyszukiwarek nie wykonują JavaScriptu, więc nie odeślą go nigdy.
#     openssl rand -hex 32
#
# ZMIENNA JEST OPCJONALNA: gdy jej nie ma, podpisujemy sekretem zadań.
# Gdy nie ma żadnego z nich, strona tabliczki w ogóle nie prosi o potwierdzenie,
# a wszystkie skany zostają „niepewne" i nie wchodzą do statystyk — czyli
# licznik pokazuje zero. To celowe: lepiej zero niż liczba z crawlerami.
SEKRET_TRAFIEN=""

# ── Redakcja aktualności ──────────────────────────────────────────────────
# Klucz do modelu językowego, który pisze szkice notek.
#
# BEZ NIEGO PORTAL DZIAŁA: obchód nadal zbiera artykuły ze źródeł, a notki
# pisze się ręcznie z wykazu znalezisk w panelu. Klucz włącza tylko codzienny
# wybór artykułu i napisanie szkicu.
#
# Klucz z console.anthropic.com. Ustaw go w zmiennych projektu na Vercelu,
# nigdy w repozytorium.
KLUCZ_ANTHROPIC=""

# ── Google Search Console ─────────────────────────────────────────────────
# Kod potwierdzenia własności witryny — z metody „Tag HTML" w Search Console.
# Sama ta zmienna wystarczy, żeby potwierdzić własność; nie daje Google'owi
# żadnego dostępu do portalu.
GOOGLE_WERYFIKACJA=""

# Odczyt danych z Search Console w panelu (zakładka Portal analityczny → Google).
# Wymaga konta usługi z Google Cloud z włączonym Search Console API, dodanego
# jako użytkownik witryny w Search Console. BEZ TEGO PORTAL DZIAŁA W CAŁOŚCI —
# brak konfiguracji wyłącza wyłącznie tę jedną zakładkę.
#
# KLUCZ to pole `private_key` z pobranego pliku JSON, wklejone w całości.
# Znaki nowej linii zostają zapisane jako \n — portal zamienia je z powrotem.
GOOGLE_KONTO_USLUGI_EMAIL=""
GOOGLE_KONTO_USLUGI_KLUCZ=""

# Adres witryny tak, jak nazywa ją Search Console. Własność domeny zapisuje się
# jako `sc-domain:szlakipienin.pl`, a własność przedrostka jako
# `https://szlakipienin.pl/` — to dwie różne rzeczy i podanie złej kończy się
# odpowiedzią „nie ma takiej witryny".
GOOGLE_WITRYNA="sc-domain:szlakipienin.pl"
