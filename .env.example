# Zmienne środowiskowe systemu tabliczek QR.
#
# Skopiuj do `.env` na czas pracy lokalnej, a na Vercelu wpisz je w ustawieniach
# projektu. Plik `.env` jest w .gitignore i nie może trafić do repozytorium.

# ── Baza danych ───────────────────────────────────────────────────────────
# DWA adresy, nie jeden — to nie pomyłka.
#
# DATABASE_URL wskazuje host z „-pooler" i służy do zwykłej pracy. Na
# środowisku bezserwerowym każde wywołanie funkcji chce własnego połączenia,
# a baza przyjmie ich ograniczoną liczbę; pula pilnuje, żeby nie zabrakło.
#
# DIRECT_URL wskazuje host bez „-pooler" i służy wyłącznie migracjom.
# PgBouncer w trybie transakcyjnym nie obsługuje instrukcji przygotowanych,
# których migracje używają — przez pulę po prostu się wywracają.
DATABASE_URL="postgresql://uzytkownik:haslo@host-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://uzytkownik:haslo@host.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ── Panel administracyjny ─────────────────────────────────────────────────
# Skrót hasła w formacie `sól:skrót`. Wygeneruj poleceniem:
#     npm run haslo -- "twoje-nowe-haslo"
# Samego hasła nigdzie nie zapisujemy — tylko ten skrót.
HASLO_PANELU="wklej-tu-wynik-polecenia"

# Sekret podpisujący ciasteczko sesji. Dowolny długi losowy ciąg:
#     openssl rand -hex 32
# Zmiana tej wartości unieważnia wszystkie sesje, co bywa przydatne.
SEKRET_SESJI="wklej-tu-losowy-ciag"

# ── Zadania cykliczne ─────────────────────────────────────────────────────
# Sekret, którym harmonogram Vercela przedstawia się trasom /api/cron/*.
# Bez niego każdy mógłby wywoływać przeliczanie statystyk w pętli.
#     openssl rand -hex 32
SEKRET_ZADAN="wklej-tu-losowy-ciag"
