// Model danych systemu kodów QR.
//
// Nazewnictwo po polsku, tak jak reszta projektu — mieszanka polskiego modelu
// domenowego z angielskimi nazwami tabel byłaby najgorsza z możliwych.
//
// Trzy tabele, nie dwie, i to jest decyzja o skalowaniu. Gdyby licznik skanów
// żył w wierszu tabliczki i rósł przy każdym skanie, wszystkie zapisy dla
// popularnego punktu ustawiałyby się w kolejce do jednego wiersza. Zamiast
// tego zdarzenia tylko dopisujemy, a liczniki i statystyki dzienne wylicza
// zadanie cykliczne. Pulpity czytają agregaty, nie miliony wierszy.

generator client {
  provider = "prisma-client-js"

  // Sterowniki zewnętrzne — bez tego Prisma nie przyjmie adaptera Neona
  // i uparcie łączyłaby się po surowym TCP.
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"

  // Połączenie robocze idzie przez pulę (host z „-pooler"). Na środowisku
  // bezserwerowym każde wywołanie funkcji chce własnego połączenia, a baza
  // przyjmie ich ograniczoną liczbę — pula pilnuje, żeby ich nie zabrakło.
  url = env("DATABASE_URL")

  // Migracje muszą omijać pulę i łączyć się wprost. PgBouncer w trybie
  // transakcyjnym nie obsługuje instrukcji przygotowanych ani poleceń
  // rozciągniętych na kilka transakcji, których migracje używają — przez pulę
  // po prostu się wywracają.
  directUrl = env("DIRECT_URL")
}

/// ZAPAS to kod wydrukowany, ale jeszcze niezamontowany — stan pośredni
/// między „nie istnieje" a „działa w terenie". Bez niego paczka dwustu kodów
/// zamówiona w drukarni musiałaby udawać, że wszystkie już wiszą.
enum StatusKodu {
  AKTYWNY
  NIEAKTYWNY
  ZAPAS
}

enum TypUrzadzenia {
  IOS
  ANDROID
  DESKTOP
  INNE
}

/// Nośnik zapisany od pierwszego dnia, choć dziś istnieje tylko QR. Gdy
/// dojdą tabliczki NFC albo beacony, wejdą do tej samej tabeli i tej samej
/// analityki — bez migracji i bez drugiego panelu.
enum Nosnik {
  QR
  NFC
  BEACON
}

/// Czy za skanem stał człowiek.
///
/// Trzy stany, nie dwa, i to jest istota rzeczy. „Nie wiem" musi być
/// stanem zapisywalnym, bo w chwili zapisu naprawdę nie wiemy: potwierdzenie
/// z przeglądarki przychodzi ułamek sekundy później. Gdyby stany były dwa,
/// trzeba by zgadywać w najgorszym możliwym momencie — a każde zgadnięcie
/// kończy się albo botem w statystykach, albo turystą wyrzuconym z nich.
enum KlasyfikacjaSkanu {
  CZLOWIEK
  BOT
  NIEPEWNY
}

/// Fizyczna tabliczka w terenie.
model KodQr {
  id String @id @default(cuid())

  /// Identyfikator z tabliczki, np. „P001". Wchodzi do adresu /qr/P001.
  kod   String  @unique
  nazwa String
  opis  String?

  /// Położenie tabliczki. Bez niego kod nie pojawi się na mapie, ale nadal
  /// działa — dlatego pola są opcjonalne.
  szerokosc Float?
  dlugosc   Float?

  /// Wysokość nad poziomem morza w metrach. Odczyt z telefonu bywa niedostępny
  /// albo mocno przybliżony, dlatego pole jest opcjonalne i nikt na nim nie
  /// polega — służy do rozpoznania miejsca, nie do nawigacji.
  wysokosc Float?

  nazwaLokalizacji String?

  /// Zdjęcie zamontowanej tabliczki jako `data:` URL.
  ///
  /// Trzymamy je w bazie, a nie w osobnym magazynie plików, i to jest
  /// świadomy kompromis. Przy dwustu tabliczkach i zdjęciu zmniejszonym
  /// w przeglądarce do 1200 px mówimy o kilkudziesięciu megabajtach — mieści
  /// się w darmowym progu Neona z zapasem. Osobny magazyn (np. Vercel Blob)
  /// oznaczałby kolejną usługę do skonfigurowania, kolejny klucz do pilnowania
  /// i kolejne miejsce, z którego dane mogą zniknąć niezależnie od bazy.
  /// Gdy zdjęć zacznie przybywać, przeniesienie ich będzie jedną migracją.
  zdjecie String?

  dataMontazu DateTime?
  status      StatusKodu @default(ZAPAS)
  nosnik      Nosnik     @default(QR)

  /// Wariant graficzny tabliczki — pod porównywanie projektów. Ten sam punkt
  /// może mieć dwie tabliczki o różnym wyglądzie i osobnych kodach.
  wariant  String?
  /// Kampania marketingowa, w ramach której kod powstał.
  kampania String?

  /// Liczniki utrzymywane przez agregację, nie przez zapis skanu.
  liczbaSkanow Int       @default(0)
  ostatniSkan  DateTime?

  utworzono DateTime @default(now())
  zmieniono DateTime @updatedAt

  skany   SkanQr[]
  dzienne SkanDzienny[]

  @@index([status])
  @@index([liczbaSkanow])
}

/// Pojedyncze zeskanowanie. Tabela wyłącznie dopisywana, czyszczona po 90
/// dniach — surowe zdarzenia służą do analiz bieżących, historia żyje
/// w agregatach.
///
/// Czego tu celowo nie ma: adresu IP w żadnej postaci, identyfikatora
/// użytkownika, ciasteczka. Liczymy skany, nie ludzi. Dzięki temu portal nie
/// potrzebuje banera zgody, a dane nie są danymi osobowymi.
model SkanQr {
  id      BigInt   @id @default(autoincrement())
  kodQrId String
  czas    DateTime @default(now())

  urzadzenie   TypUrzadzenia
  przegladarka String?
  jezyk        String?

  /// Kraj i miasto z nagłówków dostawcy hostingu — wartości pochodne, samego
  /// adresu IP nie dotykamy.
  kraj   String?
  miasto String?

  /// Adres, z którego przyszło żądanie. Przy skanie kodu zwykle pusty; ma
  /// znaczenie, gdy odnośnik trafi do sieci społecznościowej.
  zrodlo String?

  przekierowanoDoSklepu Boolean @default(false)
  wariant               String?

  /// Pełny nagłówek User-Agent, przycięty do 512 znaków.
  ///
  /// Doszedł razem z filtrem botów i tylko po to. Bez surowego tekstu nie da
  /// się sprawdzić, czy reguła odsiewająca crawlery nie odsiewa przy okazji
  /// ludzi — a reguła, której nie da się sprawdzić, prędzej czy później
  /// zaczyna kłamać i nikt tego nie zauważa.
  userAgent String?

  /// Numer sieci (ASN), z której przyszło żądanie.
  ///
  /// Wyliczany z adresu IP **w pamięci żądania** i natychmiast zapominany.
  /// Sam numer sieci nie wskazuje osoby — mówi „Amazon", a nie „ten człowiek".
  asn Int?

  klasyfikacja KlasyfikacjaSkanu @default(NIEPEWNY)

  /// Która reguła zadecydowała: `ua_blocklist`, `ua_generic`, `asn_centrum`,
  /// `metoda_http`, `bez_accept_language`, `prefetch`, `brak_beacona`,
  /// `duplikat`, `nawal`, `stare_bez_danych`, `nawal_fb_20260814`.
  powodBota String?

  /// Czy przyszło potwierdzenie z przeglądarki (patrz `tokenTrafienia`).
  potwierdzonyJs Boolean @default(false)

  /// Czy wliczać do statystyk pokazywanych w panelu.
  liczone Boolean @default(false)

  /// Jednorazowy identyfikator trafienia, wpisany w stronę i odesłany przez
  /// przeglądarkę. Jednorazowość bierze się stąd, że potwierdzenie przestawia
  /// **ten jeden wiersz** — powtórzenie żądania nie tworzy drugiego skanu,
  /// więc licznika nie da się napompować powtarzaniem.
  tokenTrafienia String? @unique

  kodQr KodQr @relation(fields: [kodQrId], references: [id], onDelete: Cascade)

  @@index([kodQrId, czas])
  @@index([czas])
  // Wszystkie zapytania statystyk filtrują po `liczone` — bez tego indeksu
  // każde z nich przechodziłoby przez całą tabelę zdarzeń.
  @@index([liczone, czas])
  @@index([kodQrId, liczone, czas])
  // Po tym indeksie chodzi zamiatanie niepotwierdzonych trafień.
  @@index([klasyfikacja, czas])
}

/// Dzienna suma skanów dla jednej tabliczki. Trzymana bezterminowo — to z niej
/// powstają wykresy i porównania sezonów.
model SkanDzienny {
  kodQrId String
  dzien   DateTime @db.Date

  liczba  Int @default(0)
  ios     Int @default(0)
  android Int @default(0)
  desktop Int @default(0)

  kodQr KodQr @relation(fields: [kodQrId], references: [id], onDelete: Cascade)

  @@id([kodQrId, dzien])
  @@index([dzien])
}

// ─── Aktualności ───────────────────────────────────────────────────────────
//
// Trzy tabele opisują drogę wiadomości od cudzej strony do naszego portalu:
// źródło, znalezisko i gotowa notka. Rozdzielenie znaleziska od notki jest tu
// najważniejsze — dzięki niemu obchód może chodzić po sieci codziennie i nic
// nie publikować, a redakcja wybiera z odłożonych znalezisk wtedy, gdy ma
// z czego wybierać. Gdyby obchód od razu tworzył notki, każdy przebieg
// zostawiałby po sobie śmieci do posprzątania.

/// Stan znaleziska w drodze przez redakcję.
enum StanZnaleziska {
  /// Świeżo znalezione, jeszcze nieoceniane.
  NOWY
  /// Ocenione i odrzucone — zostaje w bazie, żeby nie wracało przy każdym obchodzie.
  ODRZUCONE
  /// Wybrane przez redakcję i przerobione na szkic notki.
  WYKORZYSTANE
}

enum StanWiadomosci {
  /// Napisana, czeka na człowieka. Niewidoczna na portalu.
  SZKIC
  OPUBLIKOWANA
  /// Odrzucona przez administratora. Nie kasujemy, żeby redakcja uczyła się
  /// na tym, czego nie chcemy — i żeby dało się cofnąć pomyłkę.
  ODRZUCONA
}

/// Strona, po której chodzi obchód.
model ZrodloWiadomosci {
  id    String @id @default(cuid())
  nazwa String

  /// Adres strony albo wprost kanału RSS/Atom. Obchód sam rozpoznaje, co
  /// dostał, i szuka kanału w nagłówku strony, gdy podano adres zwykły.
  adres String @unique

  /// Wykryty adres kanału. Zapisujemy go po pierwszym udanym obchodzie, żeby
  /// nie powtarzać wykrywania przy każdym przebiegu.
  adresKanalu String?

  aktywne Boolean @default(true)

  ostatniObchod DateTime?
  /// Komunikat z ostatniego nieudanego obchodu. Widoczny w panelu — inaczej
  /// źródło, które przestało odpowiadać, milczałoby tygodniami.
  ostatniBlad   String?

  utworzono DateTime @default(now())
  zmieniono DateTime @updatedAt

  znaleziska ZnalezionyArtykul[]

  @@index([aktywne])
}

/// Jeden artykuł znaleziony u źródła. Trzymamy sam opis i adres — nigdy
/// całej cudzej treści. To nie jest oszczędność miejsca, tylko granica:
/// baza portalu nie ma być kopią cudzych serwisów.
model ZnalezionyArtykul {
  id       String @id @default(cuid())
  zrodloId String

  adres String  @unique
  tytul String
  /// Zajawka podana przez samo źródło w kanale — zwykle jedno, dwa zdania.
  opis  String?

  opublikowano DateTime?
  znaleziono   DateTime  @default(now())

  /// Ocena atrakcyjności 0–100 wystawiona przy wyborze dnia, wraz z krótkim
  /// uzasadnieniem. Widoczne w panelu, żeby dało się sprawdzić, czemu coś
  /// przeszło, a coś innego nie.
  ocena        Int?
  uzasadnienie String?

  stan StanZnaleziska @default(NOWY)

  zrodlo    ZrodloWiadomosci @relation(fields: [zrodloId], references: [id], onDelete: Cascade)
  wiadomosc Wiadomosc?

  @@index([stan, znaleziono])
  @@index([zrodloId])
}

/// Notka na portalu. Powstaje jako szkic i bez decyzji człowieka nigdy nie
/// wychodzi poza panel.
model Wiadomosc {
  id   String @id @default(cuid())
  slug String @unique

  tytul String
  /// Lid — jedno zdanie streszczenia, pokazywane na kartach i w zapowiedzi
  /// dla wyszukiwarek.
  lid   String
  /// Treść jako zwykły tekst; akapity rozdziela pusta linia. Bez znaczników,
  /// bo notka ma trzy akapity, a nie strukturę dokumentu.
  tresc String

  /// Zdjęcie główne jako `data:` URL — tak samo jak przy tabliczkach.
  ///
  /// Nigdy nie pobiera go redakcja. Zdjęcia w serwisach informacyjnych są
  /// najczęściej licencjonowane osobno od tekstu i to one, a nie treść, są
  /// najszybszą drogą do sporu o prawa autorskie. Zdjęcie dokłada człowiek.
  zdjecie     String?
  zdjecieOpis String?

  /// Skąd wzięła się informacja. Wypełniane zawsze, gdy notka powstała
  /// z cudzego artykułu — strona pokazuje to pod treścią i nie da się tego
  /// pominąć przez zapomnienie.
  zrodloNazwa String?
  zrodloAdres String?

  /// Czy notkę napisał model językowy. Do wiadomości administratora — szkic
  /// maszynowy czyta się inaczej niż własny.
  odRedakcjiMaszynowej Boolean @default(false)

  /// Fragmenty identyczne jak w artykule źródłowym, rozdzielone znakiem nowej
  /// linii. Wypełniane tylko wtedy, gdy kontrola zapożyczeń je znalazła.
  ///
  /// Notka z takim znacznikiem nadal powstaje i czeka w panelu — bo ukrycie
  /// jej przed człowiekiem nie usuwa problemu, tylko odbiera możliwość
  /// naprawienia go. Panel pokazuje te fragmenty wprost, żeby dało się je
  /// przepisać przed publikacją.
  zapozyczenia String?

  stan         StanWiadomosci @default(SZKIC)
  opublikowano DateTime?

  /// Data ostatniej ISTOTNEJ zmiany treści — nie każdego zapisu.
  ///
  /// `zmieniono` obok zmienia się przy poprawie literówki, więc nie nadaje się
  /// na `lastmod` w mapie witryny ani na `dateModified` w danych
  /// strukturalnych. Podawanie tam szumu uczy wyszukiwarkę, że nasze sygnały
  /// zmiany nic nie znaczą. To pole ustawia administrator świadomie, gdy
  /// poprawka zmienia sens notki, a nie jej interpunkcję.
  zaktualizowano DateTime?

  utworzono DateTime @default(now())
  zmieniono DateTime @updatedAt

  znaleziskoId String?            @unique
  znalezisko   ZnalezionyArtykul? @relation(fields: [znaleziskoId], references: [id], onDelete: SetNull)

  @@index([stan, opublikowano])
}

// ─── Odsłony i pobrania ────────────────────────────────────────────────────
//
// Ten sam wzorzec, co przy skanach tabliczek, i z tego samego powodu: surowe
// zdarzenia wyłącznie dopisujemy, a liczniki wylicza agregacja. Bez tego
// popularna atrakcja miałaby jeden wiersz, do którego ustawiałyby się w kolejce
// wszystkie zapisy z sezonu.
//
// Czego tu celowo NIE MA: adresu IP, ciasteczka, identyfikatora odwiedzającego,
// adresu strony odsyłającej. Liczymy odsłony, nie ludzi — dokładnie tak jak
// skany. Dzięki temu portal nadal nie potrzebuje banera zgody, a te dane nie
// są danymi osobowymi. Odróżnienie dwóch odsłon tej samej osoby od odsłon
// dwóch osób byłoby ciekawe, ale kosztowałoby wprowadzenie identyfikatora,
// czyli dokładnie to, czego przy tym portalu nie chcemy.

/// Co zliczamy. Rozdział na atrakcje, szlaki i aktualności jest tu po to, żeby
/// portal analityczny mógł je pokazać osobno bez zgadywania po adresie.
enum RodzajZdarzenia {
  ATRAKCJA
  SZLAK
  AKTUALNOSC
  /// Kliknięcie w odznakę sklepu. Klucz mówi, w którą.
  POBRANIE
}

model Zdarzenie {
  id     BigInt          @id @default(autoincrement())
  rodzaj RodzajZdarzenia
  /// Adres podstrony bez ukośnika wiodącego albo nazwa sklepu przy pobraniu.
  klucz  String
  czas   DateTime        @default(now())

  @@index([rodzaj, czas])
  @@index([czas])
}

/// Dzienna suma odsłon. Trzymana bezterminowo — z niej powstają porównania
/// sezonów, podczas gdy surowe zdarzenia znikają po okresie retencji.
model ZdarzenieDzienne {
  rodzaj RodzajZdarzenia
  klucz  String
  dzien  DateTime        @db.Date
  liczba Int             @default(0)

  @@id([rodzaj, klucz, dzien])
  @@index([dzien])
  @@index([rodzaj, dzien])
}

/// Ustawienia redakcji — jeden wiersz na cały portal.
///
/// **Dlaczego tabela, a nie zmienne środowiskowe.** Zmienna wymaga wdrożenia
/// przy każdej zmianie, a to są pokrętła, którymi właściciel ma kręcić sam,
/// z panelu, i widzieć skutek następnego dnia. Klucz stały wymusza jeden
/// wiersz: nie ma jak przypadkiem utworzyć drugiego zestawu ustawień, który
/// po tygodniu okazałby się tym, którego nikt nie czyta.
model UstawieniaRedakcji {
  /// Zawsze `jedyne`. Warunek unikalności pilnuje, żeby wiersz był jeden.
  klucz String @id @default("jedyne")

  /// Ile notek dziennie ma powstać. Od 1 do 10.
  ///
  /// Godziny publikacji wyliczamy z tej liczby, dzieląc równo przedział
  /// od 5:00 do 23:00 — nie zapisujemy ich, bo byłyby wtedy dwa źródła
  /// prawdy i pierwsza zmiana liczby zostawiłaby stare godziny.
  notekDziennie Int @default(1)

  /// Czy redakcja publikuje sama, bez czekania na zatwierdzenie.
  ///
  /// Domyślnie wyłączone i to jest świadome: portal firmuje właściciel,
  /// a model bywa pewny siebie i przy tym w błędzie. Włączenie tego
  /// przełącznika jest decyzją, którą trzeba podjąć raz i świadomie.
  publikowanieAutomatyczne Boolean @default(false)

  zmieniono DateTime @updatedAt
}

/// Odczyty wodowskazu w Krościenku — historia pod wykres na kafelku.
///
/// **Po co osobna tabela.** IMGW udostępnia wyłącznie ostatni pomiar; historii
/// z ich API nie da się pobrać. Sparkline z ostatniej doby musi więc powstać
/// z odczytów, które sami zapisaliśmy — inaczej trzeba by go narysować
/// z niczego, a portal nie pokazuje wymyślonych liczb.
///
/// **Dlaczego `pomiar` jest unikalny.** Bo pytamy IMGW co kwadrans, a stacja
/// raportuje rzadziej — bez tego warunku ta sama chwila trafiałaby do bazy
/// kilka razy i wykres miałby po kilka punktów w jednym miejscu.
model OdczytDunajca {
  /// Chwila pomiaru podana przez IMGW, nie chwila zapisu.
  pomiar          DateTime @id
  /// Stan wody w centymetrach.
  poziom          Int
  temperaturaWody Float?

  @@index([pomiar])
}
